# Demo Environment Variables
# Copy this to .env and fill in values

# Demo enterprise private key (nsec or hex format)
# npub: npub1803up3e9w2zehsjryspkzely66hkt8rf93k2qya7ngrng942nzgsrnwdv8
# Get nsec from Bitwarden: "SignedByMe Demo Enterprise (NOSTR keypair)"
DEMO_ENTERPRISE_NSEC=

# Enable real Lightning payments for testing (default: false)
# Only set to "true" for internal testing
DEMO_REAL_PAYMENTS=false

# Session timeout in seconds (default: 600 = 10 minutes)
DEMO_SESSION_TIMEOUT=600

# NOSTR relay URL
DEMO_RELAY_URL=wss://relay.signedbyme.com
